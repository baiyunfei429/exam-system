{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "types": [
      "node",
      "jest"
    ],
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "paths": {
      "@app/redis": [
        "./libs/redis/src"
      ],
      "@app/redis/*": [
        "./libs/redis/src/*"
      ]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./apps/exam-system/tsconfig.app.json"
    },
    {
      "path": "./apps/user/tsconfig.app.json"
    },
    {
      "path": "./apps/exam/tsconfig.app.json"
    },
    {
      "path": "./apps/answer/tsconfig.app.json"
    },
    {
      "path": "./apps/analyse/tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}